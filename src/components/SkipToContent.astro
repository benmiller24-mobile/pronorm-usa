---
/*
  Skip-navigation link — WCAG 2.4.1 Bypass Blocks.

  Render <SkipToContent /> as the FIRST element inside <body> in
  src/layouts/BaseLayout.astro, before the <header>/nav.
  The <main> element already has id="main-content".
*/
---

<a href="#main-content" class="skip-link">Skip to main content</a>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    z-index: 9999;
    padding: 0.75rem 1.25rem;
    background: var(--color-graphite, #1a1a1a);
    color: var(--color-bone, #ffffff);
    text-decoration: none;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: 2px;
    transition: top 0.15s ease-out;
  }

  .skip-link:focus,
  .skip-link:focus-visible {
    top: 0.75rem;
    outline: 3px solid var(--color-accent, #b8884d);
    outline-offset: 2px;
  }
</style>
