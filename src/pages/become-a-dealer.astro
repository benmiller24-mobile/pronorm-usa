---
import BaseLayout from '@/layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Dealer Inquiries",
  "description": "Pronorm USA is not accepting new Pronorm dealers. Find a published dealer or contact us."
};
---

<BaseLayout
    title="Dealer Inquiries"
    description="Pronorm USA is not accepting new Pronorm dealers. Find a published dealer or contact us."
    schema={schema}
    noindex={true}
>

  <section class="page-hero">
    <div class="container">
      <span class="overline animate-in">Existing dealers</span>
      <h1 class="animate-in animate-in-delay-1">Not accepting new<br/>Pronorm dealers</h1>
      <p class="subtitle animate-in animate-in-delay-2" style="max-width: 55ch;">
        Pronorm USA is not accepting new Pronorm dealers. Homeowners can find a published dealer in California, Arizona, Colorado, Nevada, or Washington. Existing dealers can sign in or contact us.
      </p>
      <div class="freeze-actions animate-in animate-in-delay-3">
        <a href="/find-a-dealer" class="btn btn-primary">Find a Dealer</a>
        <a href="/contact" class="btn btn-outline">Contact Us</a>
        <a href="/dealer-portal" class="btn btn-outline">Dealer Login</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero { padding: var(--space-5xl) 0 var(--space-4xl); }
  .freeze-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
