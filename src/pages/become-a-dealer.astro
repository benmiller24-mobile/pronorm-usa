---
import BaseLayout from '@/layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Pronorm dealer support.",
  "description": "Your showroom works with the US team on specification, factory orders, and training. We are not taking new Pronorm dealers during this period."
};
---

<BaseLayout
    title="Pronorm dealer support."
    exactTitle={true}
    description="Your showroom works with the US team on specification, factory orders, and training. We are not taking new Pronorm dealers during this period."
    schema={schema}
    noindex={true}
>

  <section class="page-hero" style="position:relative; overflow:hidden;">
    <div style="position:absolute;inset:0;background-image:url('/images/about/kitchen-studio-banner.jpg');background-size:cover;background-position:center;opacity:0.08;"></div>
    <div class="container" style="position:relative;z-index:1;">
      <span class="overline animate-in">Existing partners</span>
      <h1 class="animate-in animate-in-delay-1">Pronorm dealer support.</h1>
      <p class="subtitle animate-in animate-in-delay-2" style="max-width: 55ch;">
        This page is for existing partners only. Your showroom works with the US team on specification, factory orders, and training. Use dealer login, or contact us and we’ll route you to the person on your account. We are not taking new Pronorm dealers during this period.
      </p>
      <div class="animate-in animate-in-delay-3" style="margin-top: 2rem; display:flex; gap:1rem; flex-wrap:wrap;">
        <a href="/dealer-portal" class="btn btn-primary">Dealer Login</a>
        <a href="/contact" class="btn btn-outline">Contact us</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero { padding: var(--space-5xl) 0 var(--space-4xl); }
</style>
