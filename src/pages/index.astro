---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ConsultationCTA from '@/components/ConsultationCTA.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Pronorm USA",
  "url": "https://pronormusa.com",
  "description": "German fitted kitchens from Vlotho, planned in millimeters with American depths. See Y-line, X-line, and Proline128 at authorized dealers in CA, AZ, CO, NV, and WA.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://pronormusa.com/find-a-dealer?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<BaseLayout
  title="Pronorm USA | German Fitted Kitchens for California, Arizona, Colorado, Nevada & Washington"
  exactTitle={true}
  description="German fitted kitchens from Vlotho, planned in millimeters with American depths. See Y-line, X-line, and Proline128 at authorized dealers in CA, AZ, CO, NV, and WA."
  schema={schema}
>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-bg" style="background-image: url('/images/hero/hero-rose-brown-modern.webp'); background-size: cover; background-position: center;"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="overline animate-in" style="color: var(--color-copper);">German fitted kitchens · Made in Vlotho</span>
      <h1 class="animate-in animate-in-delay-1">Engineered<br/>for Life</h1>
      <p class="hero-subtitle animate-in animate-in-delay-2">Precision-crafted in Vlotho, Germany. Designed for the way Americans live, cook, and gather — a German system, with American depths.</p>
      <div class="hero-actions animate-in animate-in-delay-3">
        <a href="/product-lines" class="btn btn-white">
          Explore the lines
          <svg viewBox='0 0 24 24' fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/find-a-dealer" class="btn btn-outline" style="color: var(--color-cream); border-color: rgba(255,255,255,0.4);">
          Find a dealer
        </a>
      </div>
    </div>
  </section>

  <!-- ============ BRAND STATEMENT ============ -->
  <section class="brand-statement section">
    <div class="container-narrow text-center">
      <hr class="divider" style="margin: 0 auto 2rem;" />
      <h2 class="reveal">The kitchen is the heart of the home.<br/>It deserves a heartbeat of its own.</h2>
      <p class="subtitle reveal" style="margin: 1.5rem auto 0; max-width: 60ch;">
        For more than 50 years, Pronorm has built fitted kitchens in Vlotho — German engineering with warmth, texture, and a plan that fits the room you actually have.
      </p>
    </div>
  </section>

  <!-- ============ COLLECTIONS PREVIEW ============ -->
  <section class="product-lines-section section-lg bg-ivory">
    <div class="container">
      <div class="section-header reveal">
        <span class="overline">Collections</span>
        <h2 style="margin-top: 0.5rem;">Three philosophies.<br/>One system.</h2>
        <p class="subtitle" style="margin: 1rem 0 0; max-width: 60ch;">Y-line, X-line, and Proline128 share one platform. Mix handleless and handled. Mix fronts. One kitchen, not a pile of boxes.</p>
      </div>

      <div class="product-lines-grid">
        <!-- Y-line -->
        <a href="/product-lines/y-line" class="collection-card reveal">
          <div class="collection-image" style="aspect-ratio: 4/5; overflow:hidden;"><img src="/images/product-lines/yline-handleless-modern.webp" alt="Y-line Handleless Kitchen" loading="lazy" style="width:100%;height:100%;object-fit:cover;" /></div>
          <div class="collection-info">
            <h3>Y‑line</h3>
            <p>The unique handleless kitchen. An integrated grip in stainless, bronze, or black anodized. The flagship.</p>
            <span class="card-link">
              Explore Y‑line
              <svg width="16" height="16" viewBox='0 0 24 24' fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>

        <!-- X-line -->
        <a href="/product-lines/x-line" class="collection-card reveal" style="animation-delay: 0.15s;">
          <div class="collection-image" style="aspect-ratio: 4/5; overflow:hidden;"><img src="/images/product-lines/xline-handleless-classic.webp" alt="X-line Classic Handleless Kitchen" loading="lazy" style="width:100%;height:100%;object-fit:cover;" /></div>
          <div class="collection-info">
            <h3>X‑line</h3>
            <p>The classic handleless kitchen. A curved C-profile in ten colors, including stainless, black, bronze, champagne, and white.</p>
            <span class="card-link">
              Explore X‑line
              <svg width="16" height="16" viewBox='0 0 24 24' fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>

        <!-- Proline128 -->
        <a href="/product-lines/proline128" class="collection-card reveal" style="animation-delay: 0.3s;">
          <div class="collection-image" style="aspect-ratio: 4/5; overflow:hidden;"><img src="/images/product-lines/proline-classic-handles.webp" alt="Proline128 Ergonomic Kitchen" loading="lazy" style="width:100%;height:100%;object-fit:cover;" /></div>
          <div class="collection-info">
            <h3>Proline128</h3>
            <p>The ergonomic grid kitchen. A 128mm planning grid for height, handles, or push-to-open — and it mixes with Y-line or X-line.</p>
            <span class="card-link">
              Explore Proline128
              <svg width="16" height="16" viewBox='0 0 24 24' fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </div>

      <div class="text-center" style="margin-top: 3rem;">
        <a href="/product-lines" class="btn btn-outline">View All Product Lines</a>
      </div>
    </div>
  </section>

  <!-- ============ WHY PRONORM STRIP ============ -->
  <section class="why-strip section">
    <div class="container">
      <div class="why-strip-grid">
        <div class="why-strip-content reveal">
          <span class="overline">Why Pronorm</span>
          <h2 style="margin-top: 0.5rem;">German engineering.<br/>American living.</h2>
          <p style="margin-top: 1rem;">
            American cabinetry is boxes set side by side, with fillers to hide the gaps. A Pronorm kitchen is a fitted system. Base units, talls, lighting, organizers, and plinths are planned in millimeters so the kitchen reads as one piece.
          </p>
          <blockquote class="depth-callout">
            <strong>American depths.</strong> Pronorm plans US kitchens for American rooms, American appliances, and the way people stand at a sink. The factory still works in millimeters. The depth is for how you live, not a conversion on a spec sheet.
          </blockquote>
          <div class="why-features">
            <div class="why-feature">
              <strong>One system, not boxes</strong>
              <span>A fitted plan, not a pile of cabinets and fillers</span>
            </div>
            <div class="why-feature">
              <strong>Hardware you do not upgrade</strong>
              <span>Blum, Hettich, and Grass — soft-close is standard</span>
            </div>
            <div class="why-feature">
              <strong>0.1mm tolerance</strong>
              <span>CNC precision, not a hand-cut gap</span>
            </div>
            <div class="why-feature">
              <strong>5-year manufacturer guarantee</strong>
              <span>Written coverage on the fitted system</span>
            </div>
          </div>
          <a href="/why-pronorm" class="btn btn-primary" style="margin-top: 2rem;">
            Discover Our Craft
            <svg viewBox='0 0 24 24' fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="why-strip-image reveal">
          <div style="aspect-ratio: 3/4; overflow:hidden; border-radius: 4px;"><img src="/images/about/sustainability-factory.jpg" alt="Pronorm Factory Detail" loading="lazy" style="width:100%;height:100%;object-fit:cover;" /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STATS BAR ============ -->
  <section class="stats-bar bg-dark">
    <div class="container">
      <div class="stats-grid">
        <div class="stat reveal">
          <span class="stat-number">50+</span>
          <span class="stat-label">Years</span>
        </div>
        <div class="stat reveal">
          <span class="stat-number">100+</span>
          <span class="stat-label">Door fronts</span>
        </div>
        <div class="stat reveal">
          <span class="stat-number">0.1mm</span>
          <span class="stat-label">Tolerance</span>
        </div>
        <div class="stat reveal">
          <span class="stat-number">5 yr</span>
          <span class="stat-label">Guarantee</span>
        </div>
        <div class="stat reveal">
          <span class="stat-number">Vlotho</span>
          <span class="stat-label">Made in Germany</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ VIDEO SHOWCASE ============ -->
  <section class="video-showcase section-lg">
    <div class="container">
      <div class="video-grid reveal">
        <div class="video-content">
          <span class="overline">Made in Vlotho, Germany</span>
          <h2 style="margin-top: 0.5rem;">See how the kitchen is made.</h2>
          <p style="margin-top: 1rem; max-width: 45ch;">
            From board to finished run in Vlotho. This is a factory, not a warehouse of stock boxes.
          </p>
          <a href="/about" class="btn btn-outline" style="margin-top: 1.5rem;">
            The craft
            <svg viewBox='0 0 24 24' fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="video-embed">
          <div style="aspect-ratio: 16/9; border-radius: 4px; overflow: hidden; background: var(--color-black);">
            <iframe width="100%" height="100%" src="https://www.youtube.com/embed/LPddsxj-XOs" title="Pronorm German Kitchen Manufacturing" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="border:0;"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ GALLERY PREVIEW ============ -->
  <section class="gallery-preview section-lg">
    <div class="container">
      <div class="section-header text-center reveal">
        <span class="overline">Inspiration</span>
        <h2 style="margin-top: 0.5rem;">Kitchens in the West.</h2>
        <p class="subtitle" style="margin: 1rem auto 0; max-width: 50ch;">Real Pronorm kitchens in American homes — in the states where you can walk into a showroom this month.</p>
        <div class="state-filters" aria-label="Showroom states">
          <a href="/find-a-dealer">California</a>
          <a href="/find-a-dealer">Arizona</a>
          <a href="/find-a-dealer">Colorado</a>
          <a href="/find-a-dealer">Nevada</a>
          <a href="/find-a-dealer">Washington</a>
        </div>
      </div>

      <a href="/magazine/santa-barbara-linear-oak" class="featured-project reveal">
        <img src="/images/magazine/santa-barbara-linear-oak/01-kitchen-overview-wide.webp" alt="Linear oak Pronorm kitchen in Santa Barbara by The Kitchen Company" loading="lazy" />
        <div class="featured-project-caption">
          <span class="overline">Featured · California</span>
          <h3>Linear oak, Santa Barbara</h3>
          <p>The Kitchen Company / Gillian Amery</p>
        </div>
      </a>

      <div class="gallery-mosaic reveal">
        <div class="gallery-item gallery-item-wide">
          <img src="/images/gallery/modern-light-kitchen.webp" alt="Modern Handleless Kitchen" loading="lazy" style="width:100%;aspect-ratio:16/9;object-fit:cover;" />
        </div>
        <div class="gallery-item">
          <img src="/images/gallery/kitchen-island-lighting-natural.webp" alt="Walnut Island Detail" loading="lazy" style="width:100%;aspect-ratio:1;object-fit:cover;" />
        </div>
        <div class="gallery-item">
          <img src="/images/gallery/dark-contemporary-open-plan.jpg" alt="Open Plan Kitchen" loading="lazy" style="width:100%;aspect-ratio:1;object-fit:cover;" />
        </div>
        <div class="gallery-item">
          <img src="/images/surfaces/trends-2026-buffalo-mocha.webp" alt="Textured Surface Detail" loading="lazy" style="width:100%;aspect-ratio:1;object-fit:cover;" />
        </div>
        <div class="gallery-item gallery-item-wide">
          <img src="/images/gallery/contemporary-traditional-twist.jpg" alt="Transitional Kitchen" loading="lazy" style="width:100%;aspect-ratio:16/9;object-fit:cover;" />
        </div>
      </div>

      <div class="text-center" style="margin-top: 2.5rem;">
        <a href="/gallery" class="btn btn-outline">View Full Gallery</a>
      </div>
    </div>
  </section>

  <!-- ============ INSTAGRAM FEED ============ -->
  <section class="instagram-section section bg-cream">
    <div class="container text-center">
      <span class="overline">Follow @pronormusa</span>
      <h2 style="margin-top: 0.5rem;">Design Moments</h2>
      <p class="subtitle" style="margin: 0.5rem auto 2rem;">Join our community for daily inspiration, behind-the-scenes looks, and finished project reveals.</p>

      <div class="instagram-grid">
        <a href="https://www.instagram.com/pronormusa" target="_blank" rel="noopener" class="insta-item">
          <img src="/images/style-gallery/Y_LM_Mattlack-sand_ER_Alteiche-natur-BEITRAG.jpg" alt="Pronorm kitchen inspiration" loading="lazy" style="width:100%;aspect-ratio:1;object-fit:cover;" />
        </a>
        <a href="https://www.instagram.com/pronormusa" target="_blank" rel="noopener" class="insta-item">
          <img src="/images/style-gallery/X_OS_organic-platin_EE_Asteiche-schwarz-BEITRAG.jpg" alt="Pronorm kitchen inspiration" loading="lazy" style="width:100%;aspect-ratio:1;object-fit:cover;" />
        </a>
        <a href="https://www.instagram.com/pronormusa" target="_blank" rel="noopener" class="insta-item">
          <img src="/images/style-gallery/pronorm-dark-designer-kitchen-beitrag.webp" alt="Pronorm kitchen inspiration" loading="lazy" style="width:100%;aspect-ratio:1;object-fit:cover;" />
        </a>
        <a href="https://www.instagram.com/pronormusa" target="_blank" rel="noopener" class="insta-item">
          <img src="/images/style-gallery/Y_MP_arctisweiss-ultramatt_VU_Alba-Eiche-braun-BEITRAG.jpg" alt="Pronorm kitchen inspiration" loading="lazy" style="width:100%;aspect-ratio:1;object-fit:cover;" />
        </a>
        <a href="https://www.instagram.com/pronormusa" target="_blank" rel="noopener" class="insta-item">
          <img src="/images/style-gallery/pronorm-boho-oak-kitchen-handleless-white-Beitrag.webp" alt="Pronorm kitchen inspiration" loading="lazy" style="width:100%;aspect-ratio:1;object-fit:cover;" />
        </a>
        <a href="https://www.instagram.com/pronormusa" target="_blank" rel="noopener" class="insta-item">
          <img src="/images/style-gallery/X_MP_steelbrush-gold-ultramatt_LH_glanzhell-BEITRAG.jpg" alt="Pronorm kitchen inspiration" loading="lazy" style="width:100%;aspect-ratio:1;object-fit:cover;" />
        </a>
      </div>

      <a href="https://www.instagram.com/pronormusa" target="_blank" rel="noopener" class="btn btn-outline" style="margin-top: 2rem;">
        Follow on Instagram
      </a>
    </div>
  </section>

  <!-- ============ DEALER LOCATOR PREVIEW ============ -->
  <section class="dealer-preview section-lg">
    <div class="container">
      <div class="dealer-preview-grid">
        <div class="dealer-preview-content reveal">
          <span class="overline">Authorized Dealers</span>
          <h2 style="margin-top: 0.5rem;">See it in person.</h2>
          <p style="margin-top: 1rem;">
            Showrooms in California, Arizona, Colorado, Nevada, and Washington. If you do not see your city, say so — we will tell you honestly whether a dealer is in reach.
          </p>

          <form class="zip-search" action="/find-a-dealer" method="GET">
            <input type="text" name="zip" placeholder="Enter your zip code" maxlength="10" />
            <button type="submit" class="btn btn-primary">Find Dealers</button>
          </form>

          <p style="margin-top: 2rem; font-size: 0.85rem; color: var(--color-warm-gray);">
            Are you a kitchen dealer interested in offering Pronorm?
            <a href="/become-a-dealer" style="color: var(--color-copper); text-decoration: underline;">Learn about partnership opportunities →</a>
          </p>
        </div>
        <div class="dealer-preview-map reveal">
          <div style="aspect-ratio: 4/3; border-radius: 4px; overflow:hidden; background: var(--color-ivory);"><img src="/images/about/kitchen-studio-banner.jpg" alt="Pronorm Showroom" loading="lazy" style="width:100%;height:100%;object-fit:cover;" /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MAGAZINE PREVIEW ============ -->
  <section class="magazine-preview section bg-ivory">
    <div class="container">
      <div class="section-header reveal">
        <span class="overline">The Pronorm Magazine</span>
        <h2 style="margin-top: 0.5rem;">How a fitted kitchen is different.</h2>
      </div>

      <div class="magazine-grid">
        <a href="/magazine/german-vs-american-kitchens" class="magazine-card reveal">
          <img src="/images/gallery/japandi-kitchen-full.webp" alt="German vs American Kitchens" loading="lazy" style="width:100%;aspect-ratio:16/10;object-fit:cover;" />
          <div class="magazine-card-content">
            <span class="overline">Guide</span>
            <h4>German Fitted Kitchens vs. American Cabinetry: What's the Difference?</h4>
            <p>Why the system-engineered approach changes everything about how a kitchen looks, works, and lasts.</p>
          </div>
        </a>
        <a href="/magazine/handleless-kitchen-design" class="magazine-card reveal">
          <img src="/images/gallery/modern-handleless-burgundy.webp" alt="Handleless Kitchen Design" loading="lazy" style="width:100%;aspect-ratio:16/10;object-fit:cover;" />
          <div class="magazine-card-content">
            <span class="overline">Trends</span>
            <h4>The Rise of Handleless Kitchen Design in American Homes</h4>
            <p>How clean-line, grip-channel cabinetry is reshaping luxury kitchen aesthetics in American homes.</p>
          </div>
        </a>
        <a href="/magazine/sub-millimeter-precision" class="magazine-card reveal">
          <img src="/images/style-gallery/Y_MP_arctisweiss-ultramatt_VU_Alba-Eiche-braun-BEITRAG.jpg" alt="Sub-millimeter precision" loading="lazy" style="width:100%;aspect-ratio:16/10;object-fit:cover;" />
          <div class="magazine-card-content">
            <span class="overline">Guide</span>
            <h4>Why Sub-Millimeter Tolerances Matter in Your Kitchen</h4>
            <p>The engineering behind gap-free installation and a kitchen that performs as beautifully on day 5,000 as day one.</p>
          </div>
        </a>
      </div>

      <div class="text-center" style="margin-top: 2.5rem;">
        <a href="/magazine" class="btn btn-outline">Read the Magazine</a>
      </div>
    </div>
  </section>

  <!-- ============ CONSULTATION CTA ============ -->
  <ConsultationCTA
    heading="Begin with a dealer, not a catalog."
    text="Typical installations $40,000–$150,000+. Connect with an authorized Pronorm dealer for a design consultation."
  />

</BaseLayout>

<style>
  /* --- Hero --- */
  .hero {
    position: relative;
    min-height: 95vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      135deg,
      rgba(26, 26, 26, 0.7) 0%,
      rgba(26, 26, 26, 0.3) 50%,
      rgba(26, 26, 26, 0.1) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 3;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
    color: var(--color-white);
  }

  .hero h1 {
    color: var(--color-white);
    margin-top: 0.75rem;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    font-weight: 300;
    color: var(--color-sand);
    margin-top: 1rem;
    max-width: 45ch;
    line-height: 1.5;
  }

  .hero-actions {
    margin-top: 2.5rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* --- Collections --- */
  .section-header {
    margin-bottom: var(--space-3xl);
  }

  .product-lines-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .collection-card {
    display: block;
    text-decoration: none;
    overflow: hidden;
  }

  .collection-card .collection-image {
    transition: transform var(--duration-slow) var(--ease-out);
    overflow: hidden;
  }

  .collection-card:hover .collection-image {
    transform: scale(1.03);
  }

  .collection-info {
    padding: 1.5rem 0;
  }

  .collection-info h3 {
    margin-bottom: 0.5rem;
  }

  .collection-info p {
    font-size: 0.9rem;
    color: var(--color-graphite);
    margin-bottom: 1rem;
  }

  .card-link {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-copper);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .card-link svg {
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .collection-card:hover .card-link svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .product-lines-grid { grid-template-columns: 1fr; }
  }

  /* --- Why Strip --- */
  .why-strip-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-4xl);
    align-items: center;
  }

  .why-features {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  .why-feature {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .why-feature strong {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-black);
  }

  .why-feature span {
    font-size: 0.82rem;
    color: var(--color-warm-gray);
  }

  .depth-callout {
    margin: 1.5rem 0 0;
    padding: 1.1rem 1.2rem;
    border-left: 3px solid var(--color-copper);
    background: var(--color-ivory);
    font-size: 0.92rem;
    color: var(--color-graphite);
    line-height: 1.6;
  }

  .depth-callout strong {
    color: var(--color-black);
  }

  @media (max-width: 768px) {
    .why-strip-grid { grid-template-columns: 1fr; }
    .why-features { grid-template-columns: 1fr; }
  }

  /* --- Stats Bar --- */
  .stats-bar {
    padding: var(--space-3xl) 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-xl);
    text-align: center;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 300;
    color: var(--color-copper);
    display: block;
  }

  .stat-label {
    font-size: 0.78rem;
    color: var(--color-stone);
    letter-spacing: 0.04em;
    margin-top: 0.3rem;
    display: block;
  }

  /* Video Showcase */
  .video-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-4xl);
    align-items: center;
  }
